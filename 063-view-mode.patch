+  // Mode Full Fight: ubah instruksi di tengah ronde — re-split sisa damage
+  // berdasarkan rasio CORNER_MODS baru vs lama. Skor/finish ronde yang sudah
+  // ditentukan tidak berubah; ini hanya memengaruhi trajektori HP sisa ronde.
+  function handleMidRoundInstruction(advice: CornerAdvice) {
+    if (!animation) return
+    const remainingStart = animation.index
+    const remaining = animation.ticks.slice(remainingStart)
+    if (remaining.length === 0) {
+      setShowInstructionPicker(false)
+      return
+    }
+
+    const oldMods = CORNER_MODS[fight.cornerAdvice]
+    const newMods = CORNER_MODS[advice]
+    const oppDmgRatio = newMods[0] / oldMods[0] // skor saya -> damage ke lawan
+    const myDmgRatio = newMods[1] / oldMods[1]  // skor lawan -> damage ke saya
+
+    const remainingMyDmg = remaining.reduce((s, t) => s + t.my_dmg, 0)
+    const remainingOppDmg = remaining.reduce((s, t) => s + t.opp_dmg, 0)
+
+    const newMyParts = splitTotal(Math.round(remainingMyDmg * myDmgRatio), remaining.length)
+    const newOppParts = splitTotal(Math.round(remainingOppDmg * oppDmgRatio), remaining.length)
+
+    const newTicks = animation.ticks.map((t, i) => {
+      if (i < remainingStart) return t
+      const j = i - remainingStart
+      return { ...t, my_dmg: newMyParts[j], opp_dmg: newOppParts[j] }
+    })
+
+    setCornerAdvice(advice)
+    setAnimation((a) => (a ? { ...a, ticks: newTicks } : a))
+    setShowInstructionPicker(false)
+  }
+
   // Jam ronde berjalan real-time mengikuti durasi animasi narasi (5:00 -> 0:00)
   useEffect(() => {
     if (!animation) return
 
-    const totalDurationMs = 300 + (animation.ticks.length - 1) * 1300
+    const totalDurationMs = (300 + (animation.ticks.length - 1) * 1300) / speed
     const startedAt = Date.now()
 
     const interval = setInterval(() => {
@@ -851,7 +894,7 @@ export default function FightPage() {
 
     return () => clearInterval(interval)
     // eslint-disable-next-line react-hooks/exhaustive-deps
-  }, [animation !== null])
+  }, [animation !== null, speed])
 
   // Putar narasi pertarungan tick demi tick, mengikuti kondisi HP secara live
   useEffect(() => {
@@ -864,7 +907,7 @@ export default function FightPage() {
 
