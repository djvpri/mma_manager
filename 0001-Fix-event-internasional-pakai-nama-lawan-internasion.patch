Subject: [PATCH] Fix: event internasional pakai nama lawan internasional

---
 lib/generate-events.ts | 43 ++++++++++++++++++++++++++++++++++--------
 1 file changed, 35 insertions(+), 8 deletions(-)

diff --git a/lib/generate-events.ts b/lib/generate-events.ts
index 708f154..e1561a2 100644
--- a/lib/generate-events.ts
+++ b/lib/generate-events.ts
@@ -108,6 +108,14 @@ const WEIGHT_CLASSES: WeightClass[] = [
 
 const OPPONENT_COLORS = ['#3B82F6','#A855F7','#F59E0B','#06B6D4','#EC4899','#EF4444','#22C55E']
 
+const INTL_NAMES = [
+  'Carlos Medina','Viktor Volkov','Kenji Watanabe','Andre Oliveira',
+  'Marco Bianchi','Hassan Al-Rashid','Tomás Reyes','Park Jae-won',
+  'Diego Santos','Felipe Ferreira','Rodrigo Lima','James O\'Brien',
+  'Tyler Brooks','Marcus Johnson','Ivan Petrov','Alexei Morozov',
+  'Kim Sung-ho','Tanaka Ryuji','Mohammed Al-Hassan','Bruno Carvalho',
+]
+
 // ─── Venue & estimasi penonton ───────────────────────────────────────────────
 
 const VENUE_POOL: Record<EventPromotion, string[]> = {
@@ -267,7 +275,8 @@ export function getBestAvailableSlot(event: MmaEvent, fighterWins: number, title
 export async function fetchPoolOpponent(
   weightClass: WeightClass,
   targetWins: number,
-  fighterId?: string
+  fighterId?: string,
+  promotion?: string
 ): Promise<MmaEvent['slots'][0]['opponent']> {
   const supabase = createClient()
   const [{ data: poolData }, { data: cpuData }] = await Promise.all([
@@ -314,20 +323,38 @@ export async function fetchPoolOpponent(
   const fresh = candidates.filter((f) => !recentOpponentIds.includes(f.id ?? ''))
   const chosen = fresh.length > 0 ? pick(fresh) : pick(candidates)
 
-  // Cek histori pertemuan untuk rivalry: sudah pernah bertanding sebelumnya = rematch rival.
+  const isIntl = promotion === 'internasional' || promotion === 'international'
+
+  // Untuk event internasional, prioritaskan fighter CPU dengan nama internasional
+  // atau override nama dengan nama internasional agar lebih realistis
+  let chosenName = chosen.name
+  let chosenId = chosen.id ?? null
+
+  if (isIntl) {
+    // Cek apakah chosen punya nama internasional (bukan nama Indo)
+    const hasIntlName = INTL_NAMES.some((n) => chosen.name.includes(n.split(' ')[0]))
+    if (!hasIntlName) {
+      // Kalau tidak ada fighter internasional di pool, ambil nama internasional random
+      // tapi tetap pakai attrs dari fighter nyata
+      chosenName = pick(INTL_NAMES)
+      // Hapus id supaya tidak tracking ke fighter Indo yang salah
+      chosenId = null
+    }
+  }
+
   let rivalMeetings = 0
-  if (fighterId) {
+  if (fighterId && chosenId) {
     const { count } = await supabase
       .from('fight_results')
       .select('id', { count: 'exact', head: true })
       .eq('fighter_id', fighterId)
-      .eq('opponent_id', chosen.id)
+      .eq('opponent_id', chosenId)
     rivalMeetings = count ?? 0
   }
 
   return {
-    id:        chosen.id,
-    name:      chosen.name,
+    id:        chosenId,
+    name:      chosenName,
     attrs:     chosen.attrs,
     record:    chosen.record,
     specialty: chosen.specialty,
@@ -432,10 +459,10 @@ export async function registerFighterToEvent(
           rival_meetings: 0,
         }
       } else {
-        opponent = await fetchPoolOpponent(event.weight_class, fighter.record.w, fighter.id)
+        opponent = await fetchPoolOpponent(event.weight_class, fighter.record.w, fighter.id, event.promotion)
       }
     } else {
-      opponent = await fetchPoolOpponent(event.weight_class, fighter.record.w, fighter.id)
+      opponent = await fetchPoolOpponent(event.weight_class, fighter.record.w, fighter.id, event.promotion)
     }
     updatedEvents = gym.events.map((e) => {
       if (e.id !== eventId) return e
