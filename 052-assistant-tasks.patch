@@ -67,6 +76,7 @@ export async function runAssistantManagerEventRegistration(
   fighters: Fighter[]
 ): Promise<{ gym: Gym; messages: string[] }> {
   if (!gym.assistant_manager_id) return { gym, messages: [] }
